# Copy this file to .env.local for local development. Defaults run everything locally.
API_PROXY_TARGET=http://localhost:3000
# A hosted API can be used through the local Vite proxy:
# API_PROXY_TARGET=https://YOUR-API.onrender.com
# Public API URL for a cloud build (include /api):
# VITE_API_BASE_URL=https://YOUR-API.onrender.com/api
# Public origin of THIS remote (trailing slash), required outside Vercel:
# VITE_PUBLIC_BASE=https://YOUR-CATALOG.onrender.com/
# On Vercel, defaults to https://<VERCEL_URL>/ for the current deployment.
# An explicit VITE_PUBLIC_BASE takes priority. Keep system env variables exposed.
# /api requires a same-origin backend/rewrite; Vite's local proxy is not deployed.
# Explicit extra origin if loading a dev remote from an HTTPS tunnel:
# DEV_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-DEV-SHELL.onrender.com
