    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
